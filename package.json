    "ai:usage": "node scripts/ai-usage-report.mjs",
    "feedback:report": "node scripts/feedback-report.mjs",
    "vercel-build": "npm run build:web",
    "grade-server": "node server/grading-server.mjs",
    "grade-server:local": "node scripts/grade-server-local.mjs",
    "grade-server:anthropic": "AI_PROVIDER=anthropic ANTHROPIC_MODEL=claude-haiku-4-5-20251001 node server/grading-server.mjs"
  },
  "dependencies": {
