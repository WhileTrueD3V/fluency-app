    "audit:ai-quality": "node scripts/ai-quality-review.mjs",
    "audit:ai-quality:live": "AI_QUALITY_REVIEW_LIVE=1 EXPOSE_AI_COSTS=1 node scripts/ai-quality-review.mjs --live",
    "audit:ai-tiny-live": "node scripts/ai-tiny-live-qa.mjs",
